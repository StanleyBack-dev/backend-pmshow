# =====================================================================
# PM SHOW — Backend
# Copy to `.env.development` (dev). In production set these on Vercel
# (Project Settings → Environment Variables). NEVER commit real values.
# Generate secrets with: npm run secrets:generate
# =====================================================================

# === APP ===
NODE_ENV=development
PORT=4000
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=http://localhost:3000

# === DATABASE (Neon PostgreSQL) ===
# Use Neon's *pooled* connection string (host with "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/pmshow?sslmode=verify-full
DB_SSL=true
TYPEORM_LOGGING=false

# === SERVICE SECRETS ===
# Shared key BFF (Next.js) -> backend. Same value as the frontend's.
INTERNAL_API_KEY=
# Sent by the scheduled GitHub Actions workflows as
# "Authorization: Bearer <CRON_SECRET>" (same value as the repository secret).
CRON_SECRET=

# === AUTH ===
# Signs the short-lived access tokens.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Days a session stays valid without use (slides on every refresh).
REFRESH_TOKEN_TTL_DAYS=30
# HMAC key for refresh secrets, recovery codes and reset tokens.
AUTH_HASH_SECRET=
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# First ADMIN_MASTER, created on boot when none exists. Turn it off afterwards.
# Password: 8+ characters with letters and digits.
BOOTSTRAP_ADMIN_MASTER_ENABLED=false
BOOTSTRAP_ADMIN_MASTER_NAME=
BOOTSTRAP_ADMIN_MASTER_EMAIL=
BOOTSTRAP_ADMIN_MASTER_USERNAME=admin
BOOTSTRAP_ADMIN_MASTER_PASSWORD=

# === EMAIL ===
# log   = only logs to the console (use until the Brevo account exists)
# brevo = sends for real; requires BREVO_API_KEY and MAIL_FROM_EMAIL
MAIL_DRIVER=log
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=PM SHOW
