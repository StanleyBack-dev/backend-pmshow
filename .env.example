# =====================================================================
# PM SHOW — Backend
# Copie para `.env.local` (dev). Em produção configure na Vercel
# (Project Settings → Environment Variables). NUNCA versione valores reais.
# Gere segredos com: npm run secrets:generate
# =====================================================================

# === APP ===
NODE_ENV=development
PORT=4000
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=http://localhost:3000

# === DATABASE (Neon PostgreSQL) ===
# Use a connection string *pooled* do Neon (host com "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/pmshow?sslmode=verify-full
DB_SSL=true
TYPEORM_LOGGING=false

# === SEGREDOS DE SERVIÇO ===
# Chave compartilhada BFF (Next.js) -> backend. Mesma do frontend.
INTERNAL_API_KEY=
# Enviado pelos workflows agendados do GitHub Actions como
# "Authorization: Bearer <CRON_SECRET>" (mesmo valor no secret do repositório).
CRON_SECRET=

# === EMAIL ===
# log   = só registra no console (use até criar a conta na Brevo)
# brevo = envia de verdade; exige BREVO_API_KEY e MAIL_FROM_EMAIL
MAIL_DRIVER=log
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=PM SHOW
